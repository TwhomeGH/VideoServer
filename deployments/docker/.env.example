DVN_BIND_ADDRESS=0.0.0.0
DVN_NODE_PORT=18610
DVN_CENTRAL_PORT=18620
DVN_WORKER_PORT=18630
# 填寫已存在的影片目錄；Windows 範例 D:/Videos，Linux 範例 /srv/videos
DVN_MEDIA_PATH=./media
# 以下可省略，預設使用專案附帶的 config；自訂時填主機上的 JSON 檔案路徑。
# DVN_NODE_CONFIG=./deployments/docker/video-node.json
# DVN_CENTRAL_CONFIG=./deployments/docker/central.json
# DVN_WORKER_CONFIG=./deployments/docker/transcode-worker.json
